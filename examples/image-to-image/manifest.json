{
  "manifest_version": 1,
  "plugin_id": "example.image-to-image",
  "version": "1.0.0",
  "kind": "entry_format",
  "runtime": "declarative_http_v1",
  "host_api": "1",
  "name": "Image-to-image Mock",
  "description": "本地图生图测试入口。",
  "entrypoints": [{
    "entry_format_id": "example.image-to-image.edit",
    "name": "Mock 图生图",
    "operation": "edit",
    "definition": "entries/edit.json",
    "capabilities": ["image.input"],
    "image_input": { "max_count": 4, "max_bytes": 10485760, "accepts_weights": true }
  }]
}
